<!-- UI description of the split timer, same format as a theme's module templates; data is what the plugin sends -->
<column gap="6">
  <row gap="10" align="center">
    <tag text="Splits"/>
    <text text="{quest.elapsed | time}" font="number" size="22"/>
  </row>
  <for each="s in data.rows" gap="2">
    <row gap="14" align="center">
      <text text="{s.name}" size="13" width="96"/>
      <text text="{s.time}" font="number" size="13" width="64"/>
      <if when="module.show.diff">
        <text text="{s.diff}" font="number" size="13" color="{s.color}"/>
      </if>
    </row>
  </for>
</column>

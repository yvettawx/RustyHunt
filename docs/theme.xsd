<?xml version="1.0" encoding="utf-8"?>
<!-- RustyHunt 主题格式 1.x，说明见 docs/theme.md。由 scripts/gen_xsd.py 生成。 -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="urn:rustyhunt:theme:1"
           targetNamespace="urn:rustyhunt:theme:1" elementFormDefault="qualified">
  <xs:element name="theme">
    <xs:annotation><xs:documentation>主题：清单、令牌、组件样式、模块模板</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="tokens"/>
        <xs:element ref="styles"/>
        <xs:element ref="module"/>
        <xs:element ref="include"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string" use="required">
        <xs:annotation><xs:documentation>只用字母、数字、- 和 _；导入后就是文件夹名</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="name" type="xs:string" use="required">
        <xs:annotation><xs:documentation>显示的名字</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="version" type="xs:string">
        <xs:annotation><xs:documentation>主题版本</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="author" type="xs:string">
        <xs:annotation><xs:documentation>作者</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="description" type="xs:string">
        <xs:annotation><xs:documentation>简介</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="tags" type="xs:string">
        <xs:annotation><xs:documentation>标签，逗号分隔</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="app" type="xs:string">
        <xs:annotation><xs:documentation>需要的程序版本，例如 1.0</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="preview" type="xs:string">
        <xs:annotation><xs:documentation>预览图文件</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="base" type="xs:string">
        <xs:annotation><xs:documentation>light 或 dark：没写的令牌按哪套内置主题补</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="tokens">
    <xs:annotation><xs:documentation>令牌：颜色、字体、时长、尺寸。overlay 的颜色：text、text-mute、text-faint、ink、accent、danger、cool、ok、ghost、heal、track、edge、shadow、hatch、crown-gold、crown-silver、qurio；主界面的颜色以 window. 开头：paper、ink、mute、faint、line、block、onblock、accent、desk</xs:documentation></xs:annotation>
    <xs:complexType><xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="color">
        <xs:annotation><xs:documentation>value 是 #rgb、#rrggbb、#rrggbbaa 或别的颜色令牌名</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="value" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="font">
        <xs:annotation><xs:documentation>src 是主题包里的字体文件</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="family" type="xs:string"/>
          <xs:attribute name="weight" type="xs:string"/>
          <xs:attribute name="src" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="duration">
        <xs:annotation><xs:documentation>动画时长，毫秒，例如 fade、toast</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="ms" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="size">
        <xs:annotation><xs:documentation>尺寸</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="value" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:choice></xs:complexType>
  </xs:element>
  <xs:element name="styles">
    <xs:annotation><xs:documentation>组件样式：每种基础组件的外形</xs:documentation></xs:annotation>
    <xs:complexType><xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="bar">
        <xs:annotation><xs:documentation>条。for 只改某一种条：monster-hp、player-hp、monster-stamina、stamina、part、part-flinch、ailment、damage、area、weapon、debuff；shape 是 rect、round、parallelogram</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="for" type="xs:string"/>
          <xs:attribute name="shape" type="xs:string"/>
          <xs:attribute name="skew" type="xs:string"/>
          <xs:attribute name="radius" type="xs:string"/>
          <xs:attribute name="height" type="xs:string"/>
          <xs:attribute name="segments" type="xs:string"/>
          <xs:attribute name="gap" type="xs:string"/>
          <xs:attribute name="empty" type="xs:string"/>
          <xs:attribute name="density" type="xs:string"/>
          <xs:attribute name="angle" type="xs:string"/>
          <xs:attribute name="caps" type="xs:string"/>
          <xs:attribute name="edge" type="xs:string"/>
          <xs:attribute name="glow" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="tag">
        <xs:annotation><xs:documentation>名牌：shape 是 rect、cut、round</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="shape" type="xs:string"/>
          <xs:attribute name="cut" type="xs:string"/>
          <xs:attribute name="radius" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="pip">
        <xs:annotation><xs:documentation>小格：square、diamond、circle</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="shape" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="switch">
        <xs:annotation><xs:documentation>开关：square、round</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="shape" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="panel">
        <xs:annotation><xs:documentation>模块底板：none、rect、cut、round</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="shape" type="xs:string"/>
          <xs:attribute name="fill" type="xs:string"/>
          <xs:attribute name="stroke" type="xs:string"/>
          <xs:attribute name="padding" type="xs:string"/>
          <xs:attribute name="cut" type="xs:string"/>
          <xs:attribute name="radius" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="text">
        <xs:annotation><xs:documentation>文字阴影强度，0 到 3</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="shadow" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:choice></xs:complexType>
  </xs:element>
  <xs:element name="include">
    <xs:annotation><xs:documentation>引用主题包里的另一个 XML 文件，里面的 module 都会读进来</xs:documentation></xs:annotation>
    <xs:complexType><xs:attribute name="src" type="xs:string" use="required"/></xs:complexType>
  </xs:element>
  <xs:element name="module">
    <xs:annotation><xs:documentation>模块模板，只能有一个根元素。id 是 monster、buffs、damage、area、player、clock、weapon、base、perf，或者插件模块的 插件编号.模块编号</xs:documentation></xs:annotation>
    <xs:complexType><xs:group ref="node"/><xs:attribute name="id" type="xs:string" use="required"/></xs:complexType>
  </xs:element>
  <xs:group name="node"><xs:choice>
    <xs:element ref="column"/>
    <xs:element ref="row"/>
    <xs:element ref="stack"/>
    <xs:element ref="for"/>
    <xs:element ref="if"/>
    <xs:element ref="text"/>
    <xs:element ref="tag"/>
    <xs:element ref="bar"/>
    <xs:element ref="arc"/>
    <xs:element ref="ring"/>
    <xs:element ref="rect"/>
    <xs:element ref="circle"/>
    <xs:element ref="polygon"/>
    <xs:element ref="path"/>
    <xs:element ref="image"/>
    <xs:element ref="pips"/>
    <xs:element ref="line"/>
    <xs:element ref="spacer"/>
  </xs:choice></xs:group>
  <xs:element name="state">
    <xs:annotation><xs:documentation>满足 when 时改用这里写的属性，可以加动画：blink、breathe、pulse、shift；period 是周期，秒</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attribute name="when" type="xs:string" use="required">
        <xs:annotation><xs:documentation>条件表达式，例如 monster.enraged</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="animate" type="xs:string"/>
      <xs:attribute name="period" type="xs:string"/>
      <xs:anyAttribute processContents="skip"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="column">
    <xs:annotation><xs:documentation>竖排子元素</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="state" minOccurs="0" maxOccurs="unbounded"/>
        <xs:group ref="node" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="gap" type="xs:string">
        <xs:annotation><xs:documentation>子元素间距</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="align" type="xs:string">
        <xs:annotation><xs:documentation>对齐：start、center、end</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="padding" type="xs:string">
        <xs:annotation><xs:documentation>内边距</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="opacity" type="xs:string">
        <xs:annotation><xs:documentation>0 到 1</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="rotate" type="xs:string">
        <xs:annotation><xs:documentation>旋转角度</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="scale" type="xs:string">
        <xs:annotation><xs:documentation>缩放</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="skew" type="xs:string"/>
      <xs:attribute name="flip" type="xs:string"/>
      <xs:attribute name="glow" type="xs:string"/>
      <xs:attribute name="visible" type="xs:string">
        <xs:annotation><xs:documentation>表达式为假时不画</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="x" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="y" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="width" type="xs:string">
        <xs:annotation><xs:documentation>宽</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="height" type="xs:string">
        <xs:annotation><xs:documentation>高</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="row">
    <xs:annotation><xs:documentation>横排子元素</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="state" minOccurs="0" maxOccurs="unbounded"/>
        <xs:group ref="node" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="gap" type="xs:string">
        <xs:annotation><xs:documentation>子元素间距</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="align" type="xs:string">
        <xs:annotation><xs:documentation>对齐：start、center、end</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="padding" type="xs:string">
        <xs:annotation><xs:documentation>内边距</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="opacity" type="xs:string">
        <xs:annotation><xs:documentation>0 到 1</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="rotate" type="xs:string">
        <xs:annotation><xs:documentation>旋转角度</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="scale" type="xs:string">
        <xs:annotation><xs:documentation>缩放</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="skew" type="xs:string"/>
      <xs:attribute name="flip" type="xs:string"/>
      <xs:attribute name="glow" type="xs:string"/>
      <xs:attribute name="visible" type="xs:string">
        <xs:annotation><xs:documentation>表达式为假时不画</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="x" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="y" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="width" type="xs:string">
        <xs:annotation><xs:documentation>宽</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="height" type="xs:string">
        <xs:annotation><xs:documentation>高</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="stack">
    <xs:annotation><xs:documentation>子元素叠在一起</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="state" minOccurs="0" maxOccurs="unbounded"/>
        <xs:group ref="node" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="gap" type="xs:string">
        <xs:annotation><xs:documentation>子元素间距</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="align" type="xs:string">
        <xs:annotation><xs:documentation>对齐：start、center、end</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="padding" type="xs:string">
        <xs:annotation><xs:documentation>内边距</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="opacity" type="xs:string">
        <xs:annotation><xs:documentation>0 到 1</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="rotate" type="xs:string">
        <xs:annotation><xs:documentation>旋转角度</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="scale" type="xs:string">
        <xs:annotation><xs:documentation>缩放</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="skew" type="xs:string"/>
      <xs:attribute name="flip" type="xs:string"/>
      <xs:attribute name="glow" type="xs:string"/>
      <xs:attribute name="visible" type="xs:string">
        <xs:annotation><xs:documentation>表达式为假时不画</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="x" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="y" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="width" type="xs:string">
        <xs:annotation><xs:documentation>宽</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="height" type="xs:string">
        <xs:annotation><xs:documentation>高</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="for">
    <xs:annotation><xs:documentation>对列表里的每一项重复子元素，例如 each="p in monster.parts"</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="state" minOccurs="0" maxOccurs="unbounded"/>
        <xs:group ref="node" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="each" type="xs:string" use="required">
        <xs:annotation><xs:documentation>变量 in 列表字段</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="limit" type="xs:string">
        <xs:annotation><xs:documentation>最多几项</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="gap" type="xs:string">
        <xs:annotation><xs:documentation>子元素间距</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="direction" type="xs:string">
        <xs:annotation><xs:documentation>column 或 row</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="align" type="xs:string">
        <xs:annotation><xs:documentation>对齐：start、center、end</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="opacity" type="xs:string">
        <xs:annotation><xs:documentation>0 到 1</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="rotate" type="xs:string">
        <xs:annotation><xs:documentation>旋转角度</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="scale" type="xs:string">
        <xs:annotation><xs:documentation>缩放</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="skew" type="xs:string"/>
      <xs:attribute name="flip" type="xs:string"/>
      <xs:attribute name="glow" type="xs:string"/>
      <xs:attribute name="visible" type="xs:string">
        <xs:annotation><xs:documentation>表达式为假时不画</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="x" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="y" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="width" type="xs:string">
        <xs:annotation><xs:documentation>宽</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="height" type="xs:string">
        <xs:annotation><xs:documentation>高</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="if">
    <xs:annotation><xs:documentation>条件成立时才画子元素</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="state" minOccurs="0" maxOccurs="unbounded"/>
        <xs:group ref="node" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="when" type="xs:string" use="required">
        <xs:annotation><xs:documentation>条件表达式，例如 monster.enraged</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="opacity" type="xs:string">
        <xs:annotation><xs:documentation>0 到 1</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="rotate" type="xs:string">
        <xs:annotation><xs:documentation>旋转角度</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="scale" type="xs:string">
        <xs:annotation><xs:documentation>缩放</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="skew" type="xs:string"/>
      <xs:attribute name="flip" type="xs:string"/>
      <xs:attribute name="glow" type="xs:string"/>
      <xs:attribute name="visible" type="xs:string">
        <xs:annotation><xs:documentation>表达式为假时不画</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="x" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="y" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="width" type="xs:string">
        <xs:annotation><xs:documentation>宽</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="height" type="xs:string">
        <xs:annotation><xs:documentation>高</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="text">
    <xs:annotation><xs:documentation>文字</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence><xs:element ref="state" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
      <xs:attribute name="text" type="xs:string">
        <xs:annotation><xs:documentation>文字，可以写 {字段 | 过滤器}</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="font" type="xs:string">
        <xs:annotation><xs:documentation>字体令牌名</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="size" type="xs:string">
        <xs:annotation><xs:documentation>字号</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="color" type="xs:string">
        <xs:annotation><xs:documentation>颜色或颜色令牌名</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="align" type="xs:string">
        <xs:annotation><xs:documentation>对齐：start、center、end</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="spacing" type="xs:string"/>
      <xs:attribute name="shadow" type="xs:string"/>
      <xs:attribute name="opacity" type="xs:string">
        <xs:annotation><xs:documentation>0 到 1</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="rotate" type="xs:string">
        <xs:annotation><xs:documentation>旋转角度</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="scale" type="xs:string">
        <xs:annotation><xs:documentation>缩放</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="skew" type="xs:string"/>
      <xs:attribute name="flip" type="xs:string"/>
      <xs:attribute name="glow" type="xs:string"/>
      <xs:attribute name="visible" type="xs:string">
        <xs:annotation><xs:documentation>表达式为假时不画</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="x" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="y" type="xs:string">
        <xs:annotation><xs:documentation>相对位置</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="width" type="xs:string">
        <xs:annotation><xs:documentation>宽</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="height" type="xs:string">
        <xs:annotation><xs:documentation>高</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="tag">
    <xs:annotation><xs:documentation>名牌：底色块上的文字</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence><xs:element ref="state" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
      <xs:attribute name="text" type="xs:string">
        <xs:annotation><xs:documentation>文字，可以写 {字段 | 过滤器}</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="font" type="xs:string">
        <xs:annotation><xs:documentation>字体令牌名</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="size" type="xs:string">
        <xs:annotation><xs:documentation>字号</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="color" type="xs:string">
        <xs:annotation><xs:documentation>颜色或颜色令牌名</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="fill" type="xs:string">
        <xs:annotation><xs:documentation>颜色或颜色令牌名</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="shape" type="xs:string">
